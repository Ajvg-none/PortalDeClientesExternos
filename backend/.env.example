# Variables de entorno del backend (copiar a .env para uso fuera de Docker; en Docker
# las define docker-compose.yml). Nunca versionar .env reales; solo este ejemplo.

# Puerto HTTP de la API
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Cadena de conexion PostgreSQL (en Docker apunta al servicio "db")
DATABASE_URL=postgresql://portal:portal@db:5432/portal?schema=public

# Base de datos de PRUEBAS (la crea infra/db/init/01-create-test-db.sql)
TEST_DATABASE_URL=postgresql://portal:portal@db:5432/portal_test?schema=public
