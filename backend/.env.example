# Variables de entorno del backend (copiar a .env para uso fuera de Docker; en Docker
# las define docker-compose.yml). Nunca versionar .env reales; solo este ejemplo.

# Puerto HTTP de la API
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Secreto para firmar JWT (en produccion: valor largo aleatorio, nunca versionado)
JWT_SECRET=dev-jwt-secret-change-me
# Expiracion de sesion (formato vercel/ms, ej. 8h, 1d)
JWT_EXPIRES_IN=8h

# Zona horaria del negocio: agrupa las estadisticas mensuales (E5.1/RF-33) e
# interpreta los filtros por rango de fechas de los listados (REM-2026-09/R2.8).
# Usa nombres IANA, p. ej. America/Santiago. La UI muestra las fechas en la zona
# del navegador; idealmente configurar la misma zona del negocio.
ANALYTICS_TIMEZONE=UTC

# Cadena de conexion PostgreSQL (en Docker apunta al servicio "db")
DATABASE_URL=postgresql://portal:portal@db:5432/portal?schema=public

# Base de datos de PRUEBAS (la crea infra/db/init/01-create-test-db.sql).
# Debe terminar en "_test": el runner de integracion la RESETEA y se niega a
# tocar cualquier otra base (REM-2026-09/R1).
TEST_DATABASE_URL=postgresql://portal:portal@db:5432/portal_test?schema=public

# API Key del middleware para el contrato PULL (seed manual: npx tsx scripts/seed-apikey.ts)
MIDDLEWARE_API_KEY=dev-middleware-api-key-0001
